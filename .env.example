# Set to "true" to use mock API (no backend). Set to "false" to use the Airia agent via /api/airia.
NEXT_PUBLIC_USE_MOCK=false

# Server-only: Airia Pipeline Execution URL. Never exposed to the frontend.
AIRIA_PIPELINE_URL=https://api.airia.ai/v2/PipelineExecution/76167687-7cc0-420b-b8cf-e6ace89baba8

# Server-only: Airia API key. Get from Airia Studio: Settings > Interfaces > View API Info > View API Keys. Never exposed to the frontend.
AIRIA_API_KEY=
